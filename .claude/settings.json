{
  "permissions": {
    "allow": ["make qa", "make test", "make build", "make bench", "make clean"],
    "deny": ["git push --force", "rm -rf"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check $CLAUDE_TOOL_RESULT_FILEPATH 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/pre_commit_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/session_end_summary.py"
          }
        ]
      }
    ]
  },
  "env": {
    "MAX_THINKING_TOKENS": "15000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  }
}
