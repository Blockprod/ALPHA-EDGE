# --- IB Gateway Connection ---
# Your IB account ID
ALPHAEDGE_IB_ACCOUNT=YOUR_ACCOUNT_ID

# IB Gateway host (usually localhost)
ALPHAEDGE_IB_HOST=YOUR_HOST

# IB Gateway port: 4001 = live, 4002 = paper
ALPHAEDGE_IB_PORT=YOUR_PORT

# IB client ID (unique per connection)
ALPHAEDGE_IB_CLIENT_ID=YOUR_CLIENT_ID

# --- IB Gateway Auto-Launch ---
# Path to the IB Gateway installation directory (containing ibgateway.exe).
# When set, the bot auto-launches IB Gateway if it is not already running.
# Leave empty to require manual / Task Scheduler startup.
ALPHAEDGE_IB_GATEWAY_PATH=C:\Jts\ibgateway\1044

# Optional external launcher used when ALPHAEDGE_IB_LOGIN_MODE=ibc.
# Example: generated by scripts/setup_ibc_gateway.ps1
# ALPHAEDGE_IB_LAUNCHER_PATH=C:\IBC\StartGatewayAlphaEdge.bat

# --- IB Gateway Credentials ---
# IB Gateway username (IBKR login) and password.
# Used by scripts/setup_ibc_gateway.ps1 to generate the IBC launcher config.
# Not required for manual or stored-credential modes.
ALPHAEDGE_IB_USERNAME=YOUR_IBKR_USERNAME
ALPHAEDGE_IB_PASSWORD=YOUR_IBKR_PASSWORD

# Gateway login mode:
#   manual     = operator handles login manually (repo default)
#   stored     = rely on IB Gateway stored credentials
#   ibc        = launch via IBC / IBController-style automation (recommended)
# ALPHAEDGE_IB_LOGIN_MODE=ibc

# --- Trading Mode ---
# Paper trading mode: true (default) or false
# ⚠️ WARNING: Setting to "false" enables LIVE TRADING with real money!
ALPHAEDGE_PAPER=true

# --- GitHub MCP (optionnel — pour interagir avec GitHub depuis Claude Code) ---
# Générer un token sur https://github.com/settings/tokens (scopes: repo, read:org)
# GITHUB_TOKEN=

# --- Core Backend ---
# Production: set ALPHAEDGE_ENV=production to require Cython extensions (fail-fast if missing).
# CI / dev:   leave ALPHAEDGE_CORE_BACKEND unset (auto prefers compiled, falls back to stubs).
# ALPHAEDGE_ENV=production          # uncomment in production deployments
# ALPHAEDGE_CORE_BACKEND=compiled   # recommended alongside ALPHAEDGE_ENV=production
